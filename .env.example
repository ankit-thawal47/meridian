# --- Models (Anthropic default; layer is not vendor-locked) ---
ANTHROPIC_API_KEY=sk-ant-...
MERIDIAN_MODEL=claude-opus-4-8
MERIDIAN_FALLBACK_MODEL=claude-sonnet-4-6
# Cheap model used for mechanical subtasks via the model router
MERIDIAN_MODEL_FAST=claude-haiku-4-5-20251001

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0

# --- Agent budget ceilings (Property 4) ---
MERIDIAN_MAX_BUDGET_USD=5.0
MERIDIAN_MAX_TURNS=80

# --- GitHub App (Phase 4 intake; optional for Phase 0) ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# --- Workspace for per-task git worktrees ---
MERIDIAN_WORKSPACE_DIR=./.workspaces

MERIDIAN_ENV=local
