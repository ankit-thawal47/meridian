# Meridian — Azure AI stack configuration
# Copy to .env and fill in values from your Azure resources.

# ── Azure AI Foundry (model backend) ──────────────────────────────────────────
# Azure AI Foundry → your project → Models → Claude deployment → Endpoint + Key
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-project>.openai.azure.com/
AZURE_AI_FOUNDRY_KEY=<your-azure-ai-key>

# Models: use the Azure deployment names (not Anthropic model IDs)
MERIDIAN_MODEL=claude-opus-4-8                   # or your Foundry deployment name
MERIDIAN_FALLBACK_MODEL=claude-sonnet-4-6
MERIDIAN_MODEL_FAST=claude-haiku-4-5-20251001

# ── Azure Database for PostgreSQL Flexible Server ─────────────────────────────
# Azure Portal → PostgreSQL Flexible Server → Connection strings → Python
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<server>.postgres.database.azure.com:5432/meridian

# ── Azure Cache for Redis ─────────────────────────────────────────────────────
# Azure Portal → Azure Cache for Redis → Access keys → Primary connection string
REDIS_URL=rediss://:<access-key>@<cache-name>.redis.cache.windows.net:6380/0

# ── Azure Monitor / Application Insights ─────────────────────────────────────
# Azure Portal → Application Insights → Overview → Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...

# ── GitHub (issue intake + PR creation) ──────────────────────────────────────
MERIDIAN_GITHUB_TOKEN=ghp_...
MERIDIAN_GITHUB_WEBHOOK_SECRET=<webhook-secret>

# ── Agent budget ceilings ─────────────────────────────────────────────────────
MERIDIAN_MAX_BUDGET_USD=5.0
MERIDIAN_MAX_TURNS=80
